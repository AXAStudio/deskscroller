{
  "name": "deskscroller",
  "productName": "DeskScroller",
  "version": "1.0.1",
  "description": "Always-on-top Shorts / Reels / TikTok overlay for gaming",
  "author": "AXAStudio",
  "homepage": "https://github.com/AXAStudio/deskscroller",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node build/make-icon.js",
    "dist": "npm run icon && electron-builder --win",
    "release": "npm run icon && node build/release.js"
  },
  "build": {
    "appId": "com.axastudio.deskscroller",
    "productName": "DeskScroller",
    "copyright": "AXAStudio",
    "files": [
      "main.js",
      "preload.js",
      "icon.js",
      "displays.js",
      "renderer/**/*",
      "package.json",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**",
      "!node_modules/koffi/{src,vendor,doc}/**",
      "!node_modules/koffi/build/koffi/win32_x64/*.{exp,lib}"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeskScroller",
      "artifactName": "DeskScroller-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AXAStudio",
        "repo": "deskscroller",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^2.16.3"
  }
}
